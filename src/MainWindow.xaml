<Window x:Class="Catodoro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Catodoro"
        Title="CaToDoRo" Width="340" Height="340"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" UseLayoutRounding="True"
        FontFamily="Segoe UI, Malgun Gothic">

    <Window.Resources>
        <!-- 크림색 몸체에 나무 바닥과 초록 러그: 포근한 고양이 방 테마 (코드에서 그리는 부분의 색은 Theme.cs) -->
        <SolidColorBrush x:Key="BodyBrush" Color="#F7EBD7"/>
        <SolidColorBrush x:Key="BodyEdgeBrush" Color="#FDF6EA"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7FAE52"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#5E8C3A"/>
        <SolidColorBrush x:Key="InkBrush" Color="#5A4432"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8A7560"/>

        <!-- 왼쪽 위 작은 아이콘 버튼 -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#BCA98C"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A5A4432"/>
                                <Setter Property="Foreground" Value="#6E5843"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 안내 화면의 둥근 버튼 -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="15"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Foreground" Value="#6E5843"/>
            <Setter Property="Background" Value="#ECDDC4"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- 그림자 -->
        <Border Margin="20" CornerRadius="34" Background="{StaticResource BodyBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.30" Color="#3A2A18"/>
            </Border.Effect>
        </Border>

        <!-- 몸체 -->
        <Border x:Name="Body" Margin="20" CornerRadius="34" Background="{StaticResource BodyBrush}"
                BorderBrush="{StaticResource BodyEdgeBrush}" BorderThickness="1"
                MouseLeftButtonDown="Body_MouseLeftButtonDown">
            <Grid>
                <!-- 다이얼. 가운데 손잡이를 누르면 시작 / 그만두기 -->
                <local:DialControl x:Name="Dial" Width="272" Height="272"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- 설정 / 최소화 / 닫기 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="13,11,0,0">
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;"
                            Click="SettingsButton_Click"/>
                    <Button x:Name="HistoryButton" Style="{StaticResource IconButton}" Content="&#xE81C;"
                            Click="HistoryButton_Click"/>
                    <Button x:Name="MinimizeButton" Style="{StaticResource IconButton}" Content="&#xE921;" Click="MinimizeButton_Click"/>
                    <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="9" Click="CloseButton_Click"/>
                </StackPanel>

                <!-- 상태 표시등 -->
                <Ellipse x:Name="Led" Width="10" Height="10" Fill="#DBCBB0"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,21,23,0">
                    <Ellipse.Effect>
                        <DropShadowEffect x:Name="LedGlow" BlurRadius="9" ShadowDepth="0" Opacity="0" Color="#4FD15C"/>
                    </Ellipse.Effect>
                </Ellipse>

                <TextBlock x:Name="TimeText" Text="25:00" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentDarkBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,13"/>
                <TextBlock x:Name="Brand" Text="CaToDoRo" FontSize="10.5" FontWeight="Bold"
                           Foreground="{StaticResource InkBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,19,16"/>

                <!-- 둥근 판 안을 돌아다니는 고양이들 -->
                <local:CatLayer x:Name="Cats"/>

                <!-- 잠깐 떴다 사라지는 알림 -->
                <Border x:Name="ToastBox" Background="#EB4E3B2A" CornerRadius="13" Padding="12,6"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="14,0,14,40"
                        Opacity="0" IsHitTestVisible="False">
                    <TextBlock x:Name="ToastText" Foreground="White" FontSize="11.5" TextAlignment="Center" TextWrapping="Wrap"/>
                </Border>

                <!-- 결과 / 확인 화면 -->
                <Border x:Name="OverlayBox" CornerRadius="33" Background="#F5FCF5E8" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="26,0">
                        <Image x:Name="OverlayImage" Width="110" Height="80" Stretch="Fill" Margin="0,0,0,10"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <TextBlock x:Name="OverlayTitle" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource InkBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="OverlaySub" FontSize="12.5" Foreground="{StaticResource MutedBrush}" LineHeight="19"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="OverlayPrimary" Style="{StaticResource PillButton}" Click="OverlayPrimary_Click"/>
                            <Button x:Name="OverlaySecondary" Style="{StaticResource GhostButton}" Click="OverlaySecondary_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
