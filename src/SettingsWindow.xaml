<Window x:Class="Catodoro.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CaToDoRo" Width="400" Height="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#F8EEDC"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13" UseLayoutRounding="True">

    <!-- 글자는 모두 코드(ApplyLanguage)에서 현재 언어로 채운다. 문구는 Lang.cs 에 있다. -->
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinWidth" Value="64"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="Bold" Foreground="#5A4432"
                           DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <!-- 언어 선택: 고르는 즉시 화면이 바뀐다 -->
                <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="96" VerticalAlignment="Center"
                          SelectionChanged="LanguageBox_SelectionChanged">
                    <ComboBoxItem Content="한국어" Tag="ko"/>
                    <ComboBoxItem Content="English" Tag="en"/>
                </ComboBox>
                <TextBlock x:Name="LanguageLabel" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="#8A7560" Margin="0,0,8,0"/>
            </DockPanel>
            <TextBlock x:Name="IntroText" Foreground="#8A7560" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19"/>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0,14,0,14">
            <TabItem x:Name="ProgramsTab">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ProgramInput" IsEditable="True" KeyDown="ProgramInput_KeyDown"/>
                        <Button x:Name="AddProgramButton" Grid.Column="1" Margin="6,0,0,0" Click="AddProgram_Click"/>
                    </Grid>
                    <TextBlock x:Name="ProgramHint" Grid.Row="1" Foreground="#917C66" FontSize="11.5" Margin="0,6,0,8" TextWrapping="Wrap"/>
                    <ListBox x:Name="ProgramList" Grid.Row="2"/>
                    <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="False">
                        <Button x:Name="BrowseButton" DockPanel.Dock="Left" Click="BrowseProgram_Click"/>
                        <Button x:Name="RemoveProgramButton" DockPanel.Dock="Right" Click="RemoveProgram_Click"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="SitesTab">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SiteInput" Padding="4,3" KeyDown="SiteInput_KeyDown"/>
                        <Button x:Name="AddSiteButton" Grid.Column="1" Margin="6,0,0,0" Click="AddSite_Click"/>
                    </Grid>
                    <TextBlock x:Name="SiteHint" Grid.Row="1" Foreground="#917C66" FontSize="11.5" Margin="0,6,0,8" TextWrapping="Wrap"/>
                    <ListBox x:Name="SiteList" Grid.Row="2"/>
                    <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="False">
                        <Button x:Name="RemoveSiteButton" DockPanel.Dock="Right" Click="RemoveSite_Click"/>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" LastChildFill="False">
            <CheckBox x:Name="TopmostCheck" VerticalAlignment="Center" DockPanel.Dock="Left" Click="TopmostCheck_Click"/>
            <Button x:Name="CloseDialogButton" DockPanel.Dock="Right" IsCancel="True" Click="Close_Click"/>
            <TextBlock x:Name="CatCountText" Foreground="#8A7560" VerticalAlignment="Center" Margin="0,0,14,0" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
