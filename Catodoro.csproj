<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 은 Windows 10/11 에 기본 내장되어 있어, 받는 사람이 아무것도 설치하지 않아도 exe 하나로 실행됩니다. -->
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Catodoro</AssemblyName>
    <RootNamespace>Catodoro</RootNamespace>
    <StartupObject>Catodoro.App</StartupObject>
    <Version>0.6.1</Version>
    <!-- 화면에 보이는 이름은 CaToDoRo 로 쓴다. 파일·폴더 이름은 Catodoro 그대로 둔다. -->
    <Product>CaToDoRo</Product>
    <AssemblyTitle>CaToDoRo</AssemblyTitle>
    <Description>고양이가 돌아다니는 뽀모도로 타이머</Description>
    <Prefer32Bit>false</Prefer32Bit>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('Assets\catodoro.ico')">
    <ApplicationIcon>Assets\catodoro.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

</Project>
